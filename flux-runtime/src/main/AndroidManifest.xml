<?xml version="1.0" encoding="utf-8"?>
<!--
  Deliberately empty. flux-runtime registers itself with the SDK entirely through the
  @OnCreate / @OnDestroy annotations on FluxReloadReceiver's static methods (see that file).

  Those annotations are discovered by the FTC SDK's own classpath scan (ClassManager /
  AnnotatedHooksClassFilter, verified via `javap` against FtcCommon 12.0.0) over classes that are
  compiled into the RC app — which flux-runtime is, since it's a compileOnly/regular Gradle
  dependency of the app, not something pushed at runtime. No <meta-data> registration, no
  <receiver> entry, and no package attribute are needed: the namespace comes from build.gradle's
  `namespace 'dev.flux.runtime'` (AGP handles that), and the runtime registers its own
  BroadcastReceiver dynamically via Context.registerReceiver(...) from @OnCreate rather than a
  manifest-declared static receiver — a static <receiver> would only ever see broadcasts sent
  while the app isn't running, which is irrelevant here (the RC app is always running when a
  reload is requested) and manifest-declared receivers can't be swapped without a full APK
  install anyway (see docs/research/risks.md §9).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" />
