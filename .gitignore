# --- Third-party checkout -----------------------------------------------------------------
# FIRST's own repo (~300 MB). Recreated by test-ftc-project/setup.sh; our part lives in
# test-ftc-project/fixtures/, which IS committed.
test-ftc-project/sdk/

# Second clone of the same FIRST repo, wired the way a real team would consume Flux (coordinates
# + mavenLocal, no composite build) -- see test-ftc-project/README.md.
test-ftc-project/consumer/

# --- Build output -------------------------------------------------------------------------
build/
out/
.gradle/
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar

# The published artifact folder IS committed -- it is how teams consume Flux until there is a
# real remote (docs/design/distribution.md). Without these exceptions the *.jar rule above would
# silently drop the very files teams need.
!maven/**/*.jar
!maven/**/*.aar
!maven/**/*.pom
!maven/**/*.module
*.apk
*.dex

# --- Machine-specific ---------------------------------------------------------------------
local.properties
.env

# --- IDE ----------------------------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws

# --- OS -----------------------------------------------------------------------------------
.DS_Store
Thumbs.db

# Internal design/research notes. Kept locally, deliberately not published.
docs/

# Maintainer-only release tooling. Teams consume artifacts from maven/; they never run this.
scripts/
